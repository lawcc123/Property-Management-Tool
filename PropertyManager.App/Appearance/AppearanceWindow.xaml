<Window x:Class="PropertyManager.App.Appearance.AppearanceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Appearance &amp; workspace" Width="980" Height="760" MinWidth="850" MinHeight="600" Background="{DynamicResource ThemePage}" Foreground="#172B3A" WindowStartupLocation="CenterOwner">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,22"><TextBlock Text="Make the workspace yours" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Preview your colours and sidebar order. Save them for this Windows account." Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0"><StackPanel><TextBlock Text="Theme colours" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Colour preset" Margin="0,20,0,8"/><ComboBox x:Name="PresetCombo" DisplayMemberPath="Name" SelectionChanged="Preset_Changed" Padding="10" PreviewMouseWheel="IgnoreWheel"/><TextBlock Text="Accent colour" Margin="0,22,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBox x:Name="AccentText" Padding="10" MaxLength="7"/><Border x:Name="AccentSwatch" Grid.Column="1" CornerRadius="6" Margin="8,0,0,0"/></Grid><TextBlock Text="Sidebar colour" Margin="0,18,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBox x:Name="SidebarText" Padding="10" MaxLength="7"/><Border x:Name="SidebarSwatch" Grid.Column="1" CornerRadius="6" Margin="8,0,0,0"/></Grid><TextBlock Text="Use #RRGGBB values for custom colours. Choose a dark sidebar for readable labels." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,16"/><Button Content="Preview colours" Click="Preview_Click" HorizontalAlignment="Left" Padding="14,9"/><TextBlock Text="Corporation colours and warning/status colours keep their own meanings." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></ScrollViewer></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Workspace order" FontSize="18" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="Select a feature and move it up or down." Style="{StaticResource Caption}" Margin="0,8,0,14"/><ListBox x:Name="WorkspaceList" Grid.Row="2" DisplayMemberPath="Name" SelectionChanged="Workspace_Changed" BorderBrush="#DCE4E8" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle></ListBox><WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button x:Name="MoveUpButton" Content="Move up" Click="MoveUp_Click" Padding="14,9" Margin="0,0,10,0"/><Button x:Name="MoveDownButton" Content="Move down" Click="MoveDown_Click" Padding="14,9"/></WrapPanel></Grid></Border>
  </Grid>
  <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#AC4038" TextWrapping="Wrap" Margin="0,14,0,0"/>
  <DockPanel Grid.Row="3" Margin="0,20,0,0"><Button Content="Restore defaults" Click="Defaults_Click" HorizontalAlignment="Left" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/><Button Content="Save changes" Click="Save_Click" IsDefault="True" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}"/></StackPanel></DockPanel>
 </Grid>
</Window>
