<Window x:Class="PropertyManager.App.EmailLists.ExcelSheetSelectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Choose occupant worksheet" Width="480" Height="390" ResizeMode="NoResize" Background="{DynamicResource ThemePage}" Foreground="#172B3A" WindowStartupLocation="CenterOwner">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Choose a worksheet" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Select the sheet containing the BuildingLink occupant data." TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,7,0,18"/></StackPanel><ListBox x:Name="WorksheetsListBox" Grid.Row="1" DisplayMemberPath="Name" MouseDoubleClick="UseSheet_Click" BorderBrush="#DCE4E8" Padding="8"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0"/><Button Content="Use worksheet" Click="UseSheet_Click" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}"/></StackPanel></Grid>
</Window>
