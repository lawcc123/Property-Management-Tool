<Window x:Class="PropertyManager.App.EmailLists.FolderShortcutEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add/Edit Condo Corporation" Width="680" SizeToContent="Height" ResizeMode="NoResize" Background="{DynamicResource ThemePage}" Foreground="#172B3A" WindowStartupLocation="CenterOwner">
 <StackPanel Margin="28"><TextBlock x:Name="HeadingText" Text="Add/Edit Condo Corporation" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="DEMO 1001 and DEMO 2002 only. Both data folders are required and shared by all features." Style="{StaticResource Caption}" Margin="0,7,0,20"/>
  <Border Style="{StaticResource Card}" Padding="22"><StackPanel><TextBlock Text="Corporation name" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="NameCombo" Padding="10" IsEditable="False" PreviewMouseWheel="IgnoreWheel"/><TextBlock Text="Occupant Data folder" FontWeight="SemiBold" Margin="0,18,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PathText" Padding="10"/><Button Grid.Column="1" Content="Browse" Click="Browse_Click" Padding="14,9" Margin="10,0,0,0"/></Grid><TextBlock Text="Unit Data folder" FontWeight="SemiBold" Margin="0,18,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="UnitPathText" Padding="10"/><Button Grid.Column="1" Content="Browse" Click="BrowseUnit_Click" Padding="14,9" Margin="10,0,0,0"/></Grid><TextBlock Text="Folder button color" FontWeight="SemiBold" Margin="0,18,0,8"/>
<ComboBox x:Name="ColorCombo" Padding="8" SelectedValuePath="Hex">
 <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Background="{Binding Hex}" Width="18" Height="18" CornerRadius="4" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
</ComboBox><TextBlock Text="This color identifies the corporation in your saved folder buttons." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
<TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="#AC4038" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/><Button Content="Save corporation" Click="Save_Click" IsDefault="True" Foreground="{DynamicResource ThemeAccentForeground}" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}"/></StackPanel>
 </StackPanel>
</Window>
