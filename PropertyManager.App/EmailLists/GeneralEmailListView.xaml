<UserControl x:Class="PropertyManager.App.EmailLists.GeneralEmailListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:preview="clr-namespace:PropertyManager.App.Controls" xmlns:local="clr-namespace:PropertyManager.App.EmailLists" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource ThemePage}">
 <UserControl.Resources><local:EmailPageHeightConverter x:Key="EmailPageHeight"/></UserControl.Resources>
 <ScrollViewer x:Name="PageViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
 <Grid Margin="32,27,32,24">
  <Grid.Height><MultiBinding Converter="{StaticResource EmailPageHeight}"><Binding ElementName="PageViewport" Path="ViewportHeight"/><Binding ElementName="PageHeading" Path="ActualHeight"/><Binding ElementName="CorporationCard" Path="ActualHeight"/></MultiBinding></Grid.Height>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel x:Name="PageHeading" Margin="0,0,0,20"><TextBlock x:Name="PageTitle" Text="Generate Email List" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="IntroDescription" Text="Choose a corporation, refine your audience, and review your recipients." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,6,0,0"/></StackPanel>
  <Border x:Name="CorporationCard" Grid.Row="1" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,18">
   <StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Choose Condo Corporation" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="GenerateOwnerButton" Content="Generate preview" Click="Generate_Click" Visibility="Collapsed" IsEnabled="{Binding IsEnabled,ElementName=FilterPanel}" Padding="12,7" Margin="0,0,8,0" Background="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}"/><Button x:Name="ManageFoldersButton" Content="Manage corporations" Click="ManageFolders_Click" Padding="12,7"/></StackPanel></Grid>
    <TextBlock x:Name="EmptyFoldersText" Text="Set up corporations and both backup folders in BuildingLink Data or Manage corporations." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    <ScrollViewer MaxHeight="82" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0"><WrapPanel x:Name="ShortcutButtons"/></ScrollViewer>
    <Grid x:Name="SourceMetadata" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="BackupHeadingText" Text="No corporation selected" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="BackupDateText" Text="The latest occupant backup will be selected automatically." Style="{StaticResource Caption}" Margin="0,5,0,0"/><TextBlock x:Name="SourceText" Text="Local and network folders · Excel or CSV backups" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
     <Button x:Name="RefreshFolderButton" Grid.Column="1" Content="Refresh" Click="RefreshFolder_Click" Padding="14,7" VerticalAlignment="Top" Margin="12,0,0,0" IsEnabled="False"/>
    </Grid>
    <TextBlock x:Name="OwnerUnitSourceText" Visibility="Collapsed" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,0"/>
    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Expander x:Name="BackupDetails" Header="Backup &amp; source details"><StackPanel Margin="0,8,16,0"><Button x:Name="ChooseBackupButton" Content="Choose older backup" Click="ChooseBackup_Click" HorizontalAlignment="Left" Padding="12,7" IsEnabled="False"/><TextBlock Text="The latest backup is selected automatically. Choose another file only when needed." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBox x:Name="FolderText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><TextBox x:Name="SelectedFileText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Muted}"/><TextBlock x:Name="WorksheetText" Style="{StaticResource Caption}" TextWrapping="Wrap"/>    <StackPanel x:Name="OwnerMailingPanel" Visibility="Collapsed" Margin="0,14,0,0">
     <CheckBox x:Name="IncludeMailingCheck" Content="Include alternate mailing addresses" Checked="MailingOption_Changed" Unchecked="MailingOption_Changed" FontSize="12"><CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></CheckBox.ContentTemplate></CheckBox>
     <StackPanel x:Name="MailingSourcePanel" Visibility="Collapsed" Margin="0,8,0,0">
      <TextBlock x:Name="MailingSourceText" Style="{StaticResource Caption}" TextWrapping="Wrap" FontSize="11"/>
      <Button Content="Choose Unit Data backup..." Click="ChooseUnitData_Click" Padding="10,7" HorizontalAlignment="Left" Margin="0,8,0,0"/>
      <TextBlock Text="Uses alternate fields from occupant data, or matching Unit Data when needed. Missing addresses remain in the list for review." Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
    </StackPanel>
<Button Content="Use latest backup" Click="RefreshFolder_Click" IsEnabled="{Binding IsEnabled, ElementName=RefreshFolderButton}" HorizontalAlignment="Left" Padding="12,7" Margin="0,8,0,0"/></StackPanel></Expander><ProgressBar x:Name="LoadProgress" Grid.Column="1" Width="110" Height="4" IsIndeterminate="True" Visibility="Collapsed" Background="#E2E9ED" VerticalAlignment="Center"/></Grid>
   </StackPanel>
  </Border>
  <Grid x:Name="PreviewLayout" Grid.Row="2" MinHeight="420"><Grid.ColumnDefinitions><ColumnDefinition x:Name="AudienceWidthColumn" Width="320"/><ColumnDefinition x:Name="AudienceGapColumn" Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="AudienceCard" Style="{StaticResource Card}" Padding="20,18,12,18"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="GroupHeading" Text="Select groups" FontSize="17" FontWeight="SemiBold" Margin="0,0,8,16"/>
    <ScrollViewer x:Name="AudienceScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0" Margin="0,0,0,14"><StackPanel x:Name="FilterPanel" IsEnabled="False">
    <StackPanel x:Name="ListTypePanel"><TextBlock Text="List type" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ComboBox x:Name="ModeCombo" PreviewMouseWheel="Dropdown_PreviewMouseWheel" SelectedIndex="2" SelectionChanged="Filter_Changed" Padding="8"><ComboBoxItem Content="Risers"/><ComboBoxItem Content="Floors"/><ComboBoxItem Content="All residents"/><ComboBoxItem Content="On-site owners"/><ComboBoxItem Content="All owners"/><ComboBoxItem Content="Retail contacts"/><ComboBoxItem Content="Select units"/></ComboBox></StackPanel>
    <StackPanel x:Name="AudiencePanel" Margin="0,14,0,0"><TextBlock Text="Audience" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ComboBox x:Name="AudienceCombo" PreviewMouseWheel="Dropdown_PreviewMouseWheel" SelectedIndex="0" SelectionChanged="Filter_Changed" Padding="8"><ComboBoxItem Content="Residents"/><ComboBoxItem Content="On-site owners"/><ComboBoxItem Content="All owners"/><ComboBoxItem Content="All occupants"/></ComboBox></StackPanel>
    <StackPanel x:Name="UnitsPanel" Margin="0,14,0,0" Visibility="Collapsed" PreviewKeyDown="Units_PreviewKeyDown">
     <TextBlock Text="Find units" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
     <TextBox x:Name="UnitSearch" Padding="8" TextChanged="UnitSearch_TextChanged" ToolTip="Type a unit or prefix, for example 20 or PH" AutomationProperties.Name="Find units by number or prefix"/>
     <TextBlock Text="Type a unit or prefix. Right Arrow moves through matches; Enter adds a unit. You can also click a match." Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,8"/>
     <ListBox x:Name="UnitSuggestions" Visibility="Collapsed" MaxHeight="112" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="#DCE4E8" PreviewMouseUp="UnitSuggestions_MouseUp" AutomationProperties.Name="Matching units">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="2"/></Style></ListBox.ItemContainerStyle>
     </ListBox>
     <TextBlock x:Name="UnitMatchText" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
     <TextBlock Text="Selected units" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
     <WrapPanel x:Name="SelectedUnitTags"/>
     <TextBlock x:Name="NoUnitsText" Text="No units selected yet." Style="{StaticResource Caption}" FontSize="11"/>
    </StackPanel>
    <StackPanel x:Name="RiserPanel" Margin="0,14,0,0"><TextBlock Text="Riser source" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ComboBox x:Name="RiserCombo" PreviewMouseWheel="Dropdown_PreviewMouseWheel" SelectedIndex="0" SelectionChanged="Riser_Changed" Padding="8"><ComboBoxItem Content="Last two unit digits"/><ComboBoxItem Content="BuildingLink Line"/></ComboBox></StackPanel>
    <StackPanel x:Name="ValuesPanel" Margin="0,14,0,0"><TextBlock x:Name="ValuesHeading" Text="Select floors / risers" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ListBox x:Name="ValuesList" MaxHeight="132" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Multiple" SelectionChanged="Filter_Changed" BorderBrush="#DCE4E8"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="2"/></Style></ListBox.ItemContainerStyle></ListBox></StackPanel>
    <StackPanel x:Name="DefaultCorporationPanel" Visibility="Collapsed" Margin="0,0,0,14"><TextBlock Text="Default address for units without an alternate address" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/><ComboBox x:Name="DefaultCorporationCombo" DisplayMemberPath="Label" SelectionChanged="Filter_Changed" PreviewMouseWheel="Dropdown_PreviewMouseWheel" Padding="8"/><TextBlock x:Name="DefaultAddressHint" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
    <TextBlock x:Name="RuleText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,14,0,14"/>
    <CheckBox x:Name="ActiveCheck" Content="Active users and units only" IsChecked="True" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,0,12" FontSize="12"/>
    <CheckBox x:Name="DeduplicateCheck" Content="Remove duplicate emails" IsChecked="True" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,0,12" FontSize="12"/>
    <CheckBox x:Name="GroupCheck" Content="Group contacts by unit" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,0,18" FontSize="12"/>
   </StackPanel></ScrollViewer>
    <Button x:Name="GeneratePreviewButton" Grid.Row="2" IsEnabled="{Binding IsEnabled, ElementName=FilterPanel}" Margin="0,0,14,0" Content="Generate preview →" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}" Click="Generate_Click" HorizontalAlignment="Stretch" Height="44" Padding="10,8"/>
   </Grid></Border>
   <Border x:Name="PreviewCard" Grid.Column="2" Style="{StaticResource Card}" Padding="20,18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><DockPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><Button Content="Enlarge preview" preview:TablePreview.Target="{Binding ElementName=PreviewGrid}" preview:TablePreview.Title="Recipient preview" Padding="10,6" Margin="8,0,0,0"/></DockPanel><TextBlock Text="Recipient preview" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <TextBlock x:Name="SummaryText" Grid.Row="1" Text="Select a corporation to begin." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,14"/>
    <Grid Grid.Row="2"><DataGrid x:Name="PreviewGrid" IsReadOnly="False" AutoGenerateColumns="False" EnableRowVirtualization="True" RowHeight="NaN" MinRowHeight="44" SelectionMode="Single" CellEditEnding="Preview_CellEditEnding" HorizontalScrollBarVisibility="Auto">
     <DataGrid.Columns>
      <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="60" IsReadOnly="True"/>
      <DataGridTextColumn x:Name="FirstNameColumn" Header="FIRST NAME" Binding="{Binding FirstName, Mode=TwoWay}" Width="100"/>
      <DataGridTextColumn x:Name="LastNameColumn" Header="LAST NAME" Binding="{Binding LastName, Mode=TwoWay}" Width="110"/>
      <DataGridTextColumn x:Name="NamesColumn" Header="NAMES" Binding="{Binding Names, Mode=TwoWay}" Width="200" Visibility="Collapsed"/>
      <DataGridTextColumn x:Name="MailingAddressColumn" Header="ALTERNATE MAILING ADDRESS" Binding="{Binding MailingAddress}" Width="280" IsReadOnly="True" Visibility="Collapsed"/>
      <DataGridTextColumn Header="EMAIL (EDITABLE)" Binding="{Binding Email, Mode=TwoWay}" Width="220"/>
      <DataGridTextColumn x:Name="EmailStatusColumn" Header="STATUS" Binding="{Binding Status}" Width="175" IsReadOnly="True"/>
      <DataGridTextColumn x:Name="MailingNameColumn" Header="MAILING NAME" Binding="{Binding MailingName}" Width="180" IsReadOnly="True" Visibility="Collapsed"/>
      <DataGridTextColumn x:Name="MailingStatusColumn" Header="MAILING REVIEW" Binding="{Binding MailingStatus}" Width="240" IsReadOnly="True" Visibility="Collapsed"/>
      <DataGridTextColumn Header="USER TYPE" Binding="{Binding UserType}" Width="120" IsReadOnly="True"/>
      <DataGridTextColumn x:Name="FloorColumn" Header="FLOOR" Binding="{Binding Floor}" Width="60" IsReadOnly="True"/>
      <DataGridTextColumn Header="RISER" Binding="{Binding Riser}" Width="60" IsReadOnly="True"/>
     </DataGrid.Columns>
     <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Missing email"><Setter Property="Background" Value="#FFF1F0"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Invalid email"><Setter Property="Background" Value="#FFF1F0"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Duplicate removed - print only"><Setter Property="Background" Value="#FFF7E8"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Duplicate email"><Setter Property="Background" Value="#FFF7E8"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
    </DataGrid><TextBlock x:Name="EmptyPreview" Text="Your recipient list will appear here.&#x0a;&#x0a;Review names and email addresses before copying or exporting." Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330" Margin="20" IsHitTestVisible="False"/></Grid>
    <StackPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="PreviewHint" Text="Missing-email contacts stay in the list for printed notices. Source backups are never edited." Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="UseCampaignButton" Content="Use for personalized email" Click="UseCampaign_Click" IsEnabled="{Binding IsEnabled,ElementName=ExportButton}" Padding="12,9" Margin="0,0,8,0"/><Button x:Name="CopyButton" Content="Copy addresses" Click="Copy_Click" IsEnabled="False" Padding="12,9" Margin="0,0,8,0"/><Button x:Name="ExportButton" Content="Export Excel" Click="Export_Click" IsEnabled="False" Padding="14,9" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}"/></WrapPanel></StackPanel>
   </Grid></Border>
  </Grid>
 </Grid>
 </ScrollViewer>
</UserControl>
