<Window x:Class="PropertyManager.App.EmailLists.ManageFoldersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:preview="clr-namespace:PropertyManager.App.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Manage Condo Corporations" Width="900" Height="530" MinWidth="780" MinHeight="420" Background="{DynamicResource ThemePage}" Foreground="#172B3A" WindowStartupLocation="CenterOwner">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><DockPanel><DockPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><Button Content="Enlarge preview" preview:TablePreview.Target="{Binding ElementName=FoldersGrid}" preview:TablePreview.Title="Condo corporation folders" Padding="10,6" Margin="8,0,0,0"/></DockPanel><TextBlock Text="Manage Condo Corporations" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Configure DEMO 1001 and DEMO 2002 once. These folders are shared by BuildingLink downloads, email lists, owner mailing lists and Outlook sync." Style="{StaticResource Caption}" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="FoldersGrid" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Selection_Changed"><DataGrid.Columns><DataGridTemplateColumn Header="COLOR" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding ButtonColor}" Width="24" Height="24" CornerRadius="5" HorizontalAlignment="Left" ToolTip="{Binding ButtonColor}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="CORPORATION" Binding="{Binding Name}" Width="200"/><DataGridTextColumn Header="OCCUPANT DATA FOLDER" Binding="{Binding Path}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Path}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="UNIT DATA FOLDER" Binding="{Binding UnitPath}" Width="*"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="1" Margin="0,16,0,0"><Button x:Name="AddButton" Content="+ Add corporation" Click="Add_Click" Padding="12,8" Margin="0,0,8,0"/><Button x:Name="RenameButton" Content="Edit corporation / color" Click="Rename_Click" Padding="12,8" Margin="0,0,8,0"/><Button x:Name="ChangePathButton" Content="Edit folder paths" Click="ChangePath_Click" Padding="12,8" Margin="0,0,8,0"/><Button x:Name="RemoveButton" Content="Remove corporation" Click="Remove_Click" Padding="12,8"/></WrapPanel></Grid></Border>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/><Button Content="Save changes" Click="Save_Click" IsDefault="True" Foreground="{DynamicResource ThemeAccentForeground}" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}"/></StackPanel>
 </Grid>
</Window>
