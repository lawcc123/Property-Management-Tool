<Window x:Class="PropertyManager.App.Envelopes.AddressBookWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Manage mailing addresses" Width="960" Height="690" MinWidth="820" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{DynamicResource ThemePage}" Foreground="#172B3A">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="Manage mailing addresses" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Edit contractor and return addresses. Changes apply when you save this address book." Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="16"><DockPanel>
    <ComboBox x:Name="KindCombo" DockPanel.Dock="Top" SelectionChanged="Kind_Changed" PreviewMouseWheel="IgnoreWheel" Padding="8" Margin="0,0,0,12"><ComboBoxItem Content="Contractors"/><ComboBoxItem Content="Return addresses"/></ComboBox>
    <Button DockPanel.Dock="Bottom" Content="+ Add address" Click="Add_Click" Margin="0,12,0,0"/>
    <ListBox x:Name="AddressList" DisplayMemberPath="DisplayName" SelectionChanged="Address_Changed" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
   </DockPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><StackPanel>
    <TextBlock Text="Company / name" FontWeight="SemiBold"/><TextBox x:Name="CompanyText" Padding="8" TextChanged="Edited" Margin="0,6,0,12"/>
    <StackPanel x:Name="NicknamePanel"><TextBlock Text="Short name for return-address menu"/><TextBox x:Name="NicknameText" Padding="8" TextChanged="Edited" Margin="0,6,0,12"/></StackPanel>
    <TextBlock Text="Street address"/><TextBox x:Name="StreetText" Padding="8" TextChanged="Edited" AcceptsReturn="True" MinHeight="58" TextWrapping="Wrap" Margin="0,6,0,12"/>
    <TextBlock Text="City"/><TextBox x:Name="CityText" Padding="8" TextChanged="Edited" Margin="0,6,0,12"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Province / state"/><TextBox x:Name="ProvinceText" Padding="8" TextChanged="Edited" Margin="0,6,0,12"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Postal / ZIP code"/><TextBox x:Name="PostalText" Padding="8" TextChanged="Edited" Margin="0,6,0,12"/></StackPanel>
    </Grid>
    <StackPanel x:Name="LogoPanel" Margin="0,4,0,14">
     <TextBlock Text="Optional return-address logo" FontWeight="SemiBold"/>
     <Border Background="{DynamicResource ThemePage}" CornerRadius="6" Padding="12" Margin="0,8,0,8"><Image x:Name="LogoImage" Height="65" MaxWidth="230" HorizontalAlignment="Left" Stretch="Uniform"/></Border>
     <TextBlock x:Name="LogoStatus" Text="No logo selected" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
     <WrapPanel><Button Content="Choose logo..." Click="ChooseLogo_Click" Padding="12,8" Margin="0,0,8,8"/><Button x:Name="RemoveLogoButton" Content="Remove logo" Click="RemoveLogo_Click" Padding="12,8" Margin="0,0,0,8"/></WrapPanel>
     <WrapPanel><TextBlock Text="Logo width (mm)" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="LogoWidthText" Width="65" Padding="7" Text="22" TextChanged="Edited"/></WrapPanel>
     <TextBlock Text="PNG, JPEG or BMP. Printed beside the address when you enable logo printing. Small labels reduce the logo size to fit." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#AD3A36" Margin="0,0,0,12"/>
    <WrapPanel><Button Content="Save address" Click="SaveAddress_Click" Padding="12,8" Margin="0,0,8,8"/><Button x:Name="DeleteButton" Content="Delete address" Click="Delete_Click" Padding="12,8" Margin="0,0,0,8"/></WrapPanel>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,20,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="Import CSV" Click="ImportCsv_Click" Padding="12,9" Margin="0,0,8,0"/><Button Content="Export CSV" Click="ExportCsv_Click" Padding="12,9"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/><Button Content="Save address book" Click="SaveBook_Click" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}"/></StackPanel></Grid>
 </Grid>
</Window>
