<UserControl x:Class="PropertyManager.App.Envelopes.EnvelopeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:preview="clr-namespace:PropertyManager.App.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource ThemePage}">
 <Grid Margin="32,27,32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Printing contractor's address" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="MailingHelpText" Text="Create envelopes to print from Word, or print address labels in the app." Style="{StaticResource Caption}" Margin="0,6,12,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Manage addresses" Click="ManageAddresses_Click" Margin="0,0,8,0"/><Button x:Name="HistoryNavigationButton" Content="View history" Click="HistoryTab_Click"/></StackPanel></Grid>

  <ScrollViewer x:Name="EnvelopeScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0"><StackPanel>
   <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,18"><StackPanel x:Name="SettingsPanel">
    <TextBlock Text="Mailing and printer settings" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
    <StackPanel Margin="0,0,0,14"><TextBlock Text="Print onto" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ComboBox x:Name="OutputModeCombo" SelectedIndex="0" SelectionChanged="OutputMode_Changed" PreviewMouseWheel="DropdownWheel" Padding="7" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220"><ComboBoxItem Content="Envelopes"/><ComboBoxItem Content="Label sheets"/></ComboBox></StackPanel>
    <StackPanel x:Name="LabelSettingsPanel" Visibility="Collapsed" Margin="0,0,0,16">
     <TextBlock Text="Label template (US Letter sheets)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
     <ComboBox x:Name="LabelTemplateCombo" DisplayMemberPath="Label" SelectionChanged="LabelTemplate_Changed" PreviewMouseWheel="DropdownWheel" Padding="7"/>
     <TextBlock x:Name="LabelDimensionsText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,10"/>
     <Button x:Name="ChooseLabelPositionsButton" Content="Choose labels to print..." Click="LabelPositions_Click" HorizontalAlignment="Left" Padding="12,8"/>
     <TextBlock x:Name="LabelPositionSummary" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <CheckBox x:Name="IncludeReturnLabels" Content="Include return-address labels" Checked="ReturnLabels_Changed" Unchecked="ReturnLabels_Changed" Margin="0,16,0,8"/>
     <StackPanel x:Name="ReturnLabelQuantityPanel" IsEnabled="False"><WrapPanel><TextBlock Text="Number of return-address labels" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="ReturnLabelCountText" Text="1" Width="75" Padding="7" TextChanged="Field_Changed" AutomationProperties.Name="Number of return-address labels"/></WrapPanel></StackPanel>
     <TextBlock Text="Return-address labels print after contractor labels, using the selected positions. Clear contractor selections to print only return labels. Use stock approved for your printer." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>

    </StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel x:Name="ReturnSettingsPanel"><TextBlock Text="Return address" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ComboBox x:Name="ReturnCombo" DisplayMemberPath="Label" SelectionChanged="Layout_Changed" PreviewMouseWheel="DropdownWheel" Padding="7"/><CheckBox x:Name="IncludeReturnLogo" Content="Print logo beside return address" Checked="Layout_Changed" Unchecked="Layout_Changed" Margin="0,10,0,0"/><TextBlock x:Name="ReturnLogoHint" Text="Add a logo under Manage addresses - Return addresses." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
     <StackPanel x:Name="EnvelopeSizePanel" Grid.Column="2"><TextBlock Text="Envelope size" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ComboBox x:Name="SizeCombo" DisplayMemberPath="Label" SelectionChanged="Size_Changed" PreviewMouseWheel="DropdownWheel" Padding="7"/></StackPanel>
     <StackPanel x:Name="PrinterSelectionPanel" Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="Printer" Style="{StaticResource Caption}" Margin="0,0,0,6"/><DockPanel><Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshPrinters_Click" Padding="10,7" Margin="8,0,0,0"/><ComboBox x:Name="PrinterCombo" SelectionChanged="Printer_Changed" PreviewMouseWheel="DropdownWheel" Padding="7"/></DockPanel></StackPanel>
     <StackPanel x:Name="TraySelectionPanel" Grid.Row="1" Grid.Column="2" Margin="0,12,0,0"><TextBlock Text="Paper tray — select Bypass Tray for the office Sharp" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/><ComboBox x:Name="TrayCombo" SelectionChanged="Tray_Changed" PreviewMouseWheel="DropdownWheel" Padding="7"/></StackPanel>
     <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0"><TextBlock Text="Width (mm)" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="WidthText" Width="66" Padding="6" TextChanged="Field_Changed" Margin="0,0,14,0"/><TextBlock Text="Height (mm)" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="HeightText" Width="66" Padding="6" TextChanged="Field_Changed" Margin="0,0,14,0"/><TextBlock Text="Copies per recipient" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="CopiesText" Width="48" Padding="6" TextChanged="Field_Changed" Text="1"/></WrapPanel>
     <Expander Grid.Row="3" Grid.ColumnSpan="3" Header="Text and alignment" Margin="0,14,0,0"><StackPanel Margin="0,10,0,0">
      <WrapPanel><TextBlock Text="Recipient font (pt)" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="FontText" Width="48" Padding="6" TextChanged="Field_Changed" Text="14" Margin="0,0,14,8"/><TextBlock Text="Return font (pt)" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="ReturnFontText" Width="48" Padding="6" TextChanged="Field_Changed" Text="9" Margin="0,0,14,8"/><TextBlock Text="Move right (mm)" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="OffsetXText" Width="48" Padding="6" TextChanged="Field_Changed" Text="0" Margin="0,0,14,8"/><TextBlock Text="Move down (mm)" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="OffsetYText" Width="48" Padding="6" TextChanged="Field_Changed" Text="0" Margin="0,0,14,8"/></WrapPanel>
      <CheckBox x:Name="RotateCheck" Content="Rotate print image 180°" Checked="Layout_Changed" Unchecked="Layout_Changed" Margin="0,0,0,12"/>
      <WrapPanel x:Name="DriverActionsPanel"><Button Content="Check printer settings" Click="ValidatePrinter_Click" Padding="12,8" Margin="0,0,8,8"/><Button Content="Printer diagnostics" Click="Diagnostics_Click" Padding="12,8" Margin="0,0,8,8"/><Button Content="Save alignment / tray choices" Click="SaveProfile_Click" Padding="12,8" Margin="0,0,0,8"/></WrapPanel>
     </StackPanel></Expander>
    </Grid>
    <CheckBox x:Name="DefaultBypassCheck" Content="Default to Bypass Tray" IsChecked="True" Checked="DefaultBypass_Changed" Unchecked="DefaultBypass_Changed" Margin="0,14,0,0" ToolTip="Preselect Bypass when no tray is chosen. A tray selected in Printer properties is respected."/>
    <TextBlock x:Name="DriverInstructions" Text="Use Printer properties to change this job's driver settings. Print uses the chosen settings without opening a print dialog." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>

    <TextBlock x:Name="LoadingInstructions" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <TextBlock x:Name="PrinterStatus" Text="Preview works without a printer. Select your office printer when available." Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"/>
   </StackPanel></Border>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="RecipientsPanel" Style="{StaticResource Card}" Padding="20" VerticalAlignment="Top"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><DockPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><Button Content="Enlarge preview" preview:TablePreview.Target="{Binding ElementName=RecipientsGrid}" preview:TablePreview.Title="Contractor recipients" Padding="10,6" Margin="8,0,0,0"/></DockPanel><TextBlock Text="Recipients" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     <TextBox x:Name="SearchText" Grid.Row="1" TextChanged="Search_Changed" Padding="8" Margin="0,12,0,8" AutomationProperties.Name="Search contractor names and addresses" ToolTip="Search contractor names and addresses"/>
     <WrapPanel Grid.Row="2" Margin="0,0,0,10"><Button Content="Select shown" Click="SelectShown_Click" Padding="10,6" Margin="0,0,7,0"/><Button Content="Clear selection" Click="ClearSelection_Click" Padding="10,6"/></WrapPanel>
     <DataGrid x:Name="RecipientsGrid" Grid.Row="3" IsReadOnly="False" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="Recipient_Changed" Height="360" MinHeight="180" VerticalAlignment="Top" HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns><DataGridTemplateColumn Header="" Width="38"><DataGridTemplateColumn.CellStyle><Style TargetType="DataGridCell"><Setter Property="Padding" Value="0"/></Style></DataGridTemplateColumn.CellStyle><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="CONTRACTOR" Binding="{Binding Company}" Width="*" MinWidth="140" IsReadOnly="True"/><DataGridTextColumn Header="CITY" Binding="{Binding City}" Width="100" IsReadOnly="True"/></DataGrid.Columns>
     </DataGrid>
     <StackPanel Grid.Row="4"><TextBlock x:Name="SelectionText" Text="0 recipients selected" Style="{StaticResource Caption}" Margin="0,12,0,0"/><TextBlock x:Name="SourceText" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,6,0,0"/><Button x:Name="CurrentBookButton" Content="Return to current address book" Click="CurrentBook_Click" Visibility="Collapsed" HorizontalAlignment="Left" Padding="10,6" Margin="0,10,0,0"/></StackPanel>
    </Grid></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Mailing preview" FontSize="17" FontWeight="SemiBold"/>
     <StackPanel Grid.Row="1" Margin="0,10,0,10"><TextBlock x:Name="PreviewCaption" Style="{StaticResource Caption}" TextWrapping="Wrap"/><Button x:Name="PreviewLabelPositionsButton" Content="Choose labels to print..." Click="LabelPositions_Click" Visibility="Collapsed" IsEnabled="{Binding IsEnabled,ElementName=SettingsPanel}" HorizontalAlignment="Left" Padding="12,8" Margin="0,10,0,0"/></StackPanel>
     <Border Grid.Row="2" Background="#EDF2F5" Padding="12" MinHeight="170" CornerRadius="6"><Image x:Name="PreviewImage" MaxHeight="430" Stretch="Uniform" VerticalAlignment="Center" AutomationProperties.Name="Envelope print layout preview"/></Border>
     <StackPanel Grid.Row="3"><TextBlock x:Name="PreviewWarnings" Foreground="#A34135" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/><TextBlock x:Name="GuideText" Text="Dashed guides are provisional until the printer settings are checked. Guides are not printed." Style="{StaticResource Caption}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/></StackPanel>
     <WrapPanel x:Name="PreviewActions" Grid.Row="4" Margin="0,12,0,0"><Button Content="←" Click="Previous_Click" Padding="10,6" Margin="0,0,7,0" AutomationProperties.Name="Previous recipient preview"/><Button Content="→" Click="Next_Click" Padding="10,6" Margin="0,0,7,0" AutomationProperties.Name="Next recipient preview"/><Button Content="Enlarge preview" Click="EnlargePreview_Click" Padding="10,6" Margin="0,0,0,7"/></WrapPanel>
    </Grid></Border>
   </Grid>
   <Border Style="{StaticResource Card}" Padding="20" Margin="0,18,0,0"><StackPanel>
    <WrapPanel><Button x:Name="PrinterPropertiesButton" Content="Printer properties..." Click="DriverPreferences_Click" Padding="12,9" Margin="0,0,8,8"/><Button x:Name="PrintButton" Content="Print selected labels" Click="Print_Click" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}" Margin="0,0,8,8"/><Button x:Name="CreateWordButton" Content="Create Word document to print" Click="CreateWord_Click" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}" Padding="14,10" Margin="0,0,8,8"/><Button x:Name="CancelPrintButton" Content="Cancel submission" Click="CancelPrint_Click" IsEnabled="False" Margin="0,0,0,8"/></WrapPanel>
    <ProgressBar x:Name="PrintProgress" Height="5" Margin="0,8,0,10" Background="#E2E9ED"/>
    <TextBlock x:Name="StatusText" Text="Select contractors and create a Word document, then print it from Word." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
  <Border x:Name="HistoryPanel" Grid.Row="2" Style="{StaticResource Card}" Padding="20" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Mailing request history" FontSize="19" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Refresh" Click="RefreshHistory_Click" Padding="12,7"/><Button Content="Enlarge preview" preview:TablePreview.Target="{Binding ElementName=HistoryGrid}" preview:TablePreview.Title="Mailing request history" Padding="10,6" Margin="8,0,0,0"/></StackPanel></Grid>
   <StackPanel Grid.Row="1" Margin="0,12,0,14"><TextBox x:Name="HistorySearch" TextChanged="HistorySearch_Changed" Padding="8" AutomationProperties.Name="Search envelope history" ToolTip="Search recipients, printer, request ID, or status"/><WrapPanel Margin="0,10,0,0"><TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,7,0"/><DatePicker x:Name="FromDate" SelectedDateChanged="HistoryDate_Changed" Width="135" Margin="0,0,12,0"/><TextBlock Text="Through" VerticalAlignment="Center" Margin="0,0,7,0"/><DatePicker x:Name="ToDate" SelectedDateChanged="HistoryDate_Changed" Width="135"/></WrapPanel><TextBlock Text="Ctrl+click to select multiple requests, Shift+click for a range, or Ctrl+A in the table to select all visible rows." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="HistoryStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
   <DataGrid x:Name="HistoryGrid" Grid.Row="2" SelectionChanged="HistorySelection_Changed" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="REQUESTED (Example City)" Binding="{Binding RequestedLocal}" Width="205"/><DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="90"/><DataGridTextColumn Header="PAGES" Binding="{Binding Pages}" Width="90"/><DataGridTextColumn Header="ITEMS" Binding="{Binding Snapshot.Items}" Width="75"/><DataGridTextColumn Header="LAYOUT" Binding="{Binding EnvelopeSize}" Width="240"/><DataGridTextColumn Header="RECIPIENTS" Binding="{Binding RecipientSummary}" Width="230"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="240"/><DataGridTextColumn Header="PRINTER" Binding="{Binding Snapshot.Options.Printer}" Width="200"/></DataGrid.Columns></DataGrid>
   <WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button x:Name="HistoryDetailsButton" Content="View details" IsEnabled="False" Click="HistoryDetails_Click" Padding="12,8" Margin="0,0,8,8"/><Button x:Name="LoadHistoryButton" IsEnabled="False" Content="Load preview / repeat" Click="LoadHistory_Click" Padding="12,8" Margin="0,0,8,8"/><Button x:Name="HistoryQueueButton" IsEnabled="False" Content="Refresh queue status" Click="QueueStatus_Click" Padding="12,8" Margin="0,0,8,8"/><Button Content="Export history CSV" Click="ExportHistory_Click" Padding="12,8" Margin="0,0,0,8"/><Button x:Name="DeleteHistoryButton" Content="Delete selected history" Click="DeleteHistory_Click" Padding="12,8" Margin="8,0,0,8" Foreground="#A34135" IsEnabled="False"/></WrapPanel>
  </Grid></Border>
 </Grid>
</UserControl>
