<Window x:Class="PropertyManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:preview="clr-namespace:PropertyManager.App.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Property Manager Demo | Public showcase" Width="1320" Height="920" MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen" Background="{DynamicResource ThemePage}" Foreground="#172B3A" FontFamily="Segoe UI" UseLayoutRounding="True">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource ThemeSidebar}">
   <Grid Margin="16,20,16,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <Border Background="{DynamicResource ThemeSidebarSelected}" CornerRadius="12" Width="38" Height="38" HorizontalAlignment="Left"><TextBlock Text="P" Foreground="{DynamicResource ThemeSidebarIcon}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="Property Manager Demo" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,10,0,4"/>
     <TextBlock Text="PROPERTY MANAGEMENT" Foreground="{DynamicResource ThemeSidebarMuted}" FontSize="10"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,22,0,8"><ScrollViewer x:Name="SidebarScroll" Style="{StaticResource SidebarScrollViewer}" ScrollChanged="SidebarScroll_Changed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock Text="WORKSPACE" Foreground="{DynamicResource ThemeSidebarMuted}" FontSize="10" Margin="12,0,0,13"/>
     <StackPanel x:Name="WorkspaceItems"><StackPanel x:Name="RegistryNavigationItem"><Button x:Name="RegistryNavigation" Style="{StaticResource SidebarButton}" Background="{DynamicResource ThemeSidebarSelected}" Click="RegistryNavigation_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M 20,8 A 8,8 0 0 0 6,5 L 3,8 M 3,3 L 3,8 8,8 M 4,16 A 8,8 0 0 0 18,19 L 21,16 M 16,16 L 21,16 21,21" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource ThemeSidebarIcon}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock Grid.Column="1" Text="Registry Sync" Foreground="White" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/></Grid></Button>
     <TextBlock x:Name="RegistryNavStatus" Foreground="{DynamicResource ThemeSidebarMuted}" FontSize="11" Margin="14,5,0,4" Visibility="Collapsed"/></StackPanel>
     <Button x:Name="EmailListNavigation" Style="{StaticResource SidebarButton}" Click="EmailListNavigation_Click" Margin="0,5,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M 2,5 L 22,5 22,19 2,19 Z M 2,5 L 12,13 22,5" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource ThemeSidebarIcon}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock Grid.Column="1" Text="Generate Email List" Foreground="White" FontSize="14" TextWrapping="Wrap"/></Grid></Button>
     <Button x:Name="OwnerMailingNavigation" Style="{StaticResource SidebarButton}" Click="OwnerMailingNavigation_Click" Margin="0,5,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M 3,11 L 12,3 21,11 M 5,10 L 5,21 19,21 19,10 M 9,21 L 9,14 15,14 15,21" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource ThemeSidebarIcon}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock Grid.Column="1" Text="Owner Mailing List" Foreground="White" FontSize="14" TextWrapping="Wrap"/></Grid></Button>
     <Button x:Name="BuildingLinkNavigation" Style="{StaticResource SidebarButton}" Click="BuildingLinkNavigation_Click" Margin="0,5,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M 12,2 L 12,16 M 6,10 L 12,16 18,10 M 3,16 L 3,22 21,22 21,16" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource ThemeSidebarIcon}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock Grid.Column="1" Text="BuildingLink Data" Foreground="White" FontSize="14" TextWrapping="Wrap"/></Grid></Button>
     <Button x:Name="EnvelopeNavigation" Style="{StaticResource SidebarButton}" Click="EnvelopeNavigation_Click" Margin="0,5,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M 6,8 L 6,2 18,2 18,8 M 6,18 L 2,18 2,8 22,8 22,18 18,18 M 6,14 L 18,14 18,22 6,22 Z M 17,11 L 19,11" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource ThemeSidebarIcon}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock Grid.Column="1" Text="Printing contractor's address" Foreground="White" FontSize="14" TextWrapping="Wrap"/></Grid></Button>
     <Button x:Name="OutlookSyncNavigation" Style="{StaticResource SidebarButton}" Click="OutlookSyncNavigation_Click" Margin="0,5,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M 3,3 L 17,3 17,21 3,21 Z M 7,7 L 13,7 M 7,11 L 11,11 M 20,7 L 23,10 20,13 M 23,10 L 17,10" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource ThemeSidebarIcon}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Outlook Contact Sync" Foreground="White" FontSize="14" TextWrapping="Wrap"/></Grid></Button>
     <Button x:Name="OperationsNavigation" Style="{StaticResource SidebarButton}" Click="OperationsNavigation_Click" Margin="0,5,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M 3,5 L 21,5 21,22 3,22 Z M 7,2 L 7,8 M 17,2 L 17,8 M 3,11 L 21,11 M 7,15 L 11,15 M 7,18 L 15,18" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource ThemeSidebarIcon}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Reservations &amp; Reminders" Foreground="White" FontSize="14" TextWrapping="Wrap"/></Grid></Button>

     <Button x:Name="PersonalizedEmailNavigation" Style="{StaticResource SidebarButton}" Click="PersonalizedEmailNavigation_Click" Margin="0,5,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M 2,4 L 22,12 2,20 6,12 Z M 6,12 L 16,12" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource ThemeSidebarIcon}" StrokeThickness="1.5" StrokeLineJoin="Round" VerticalAlignment="Center" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="Personalized Email" Foreground="White" FontSize="14" TextWrapping="Wrap"/></Grid></Button>
     </StackPanel><TextBlock Text="MORE TOOLS" Foreground="{DynamicResource ThemeSidebarMuted}" FontSize="10" Margin="12,20,0,12"/>
     <StackPanel Margin="14,0,0,0" Opacity="0.65">
      <TextBlock Text="Purchase Orders" Foreground="{DynamicResource ThemeSidebarMuted}" FontSize="14"/>
      <TextBlock Text="Planned for a future version" Foreground="{DynamicResource ThemeSidebarMuted}" FontSize="10" Margin="0,12,0,0"/>
     </StackPanel>
    </StackPanel></ScrollViewer>
     <Border x:Name="SidebarTopFade" Height="14" VerticalAlignment="Top" Margin="0,0,12,0" IsHitTestVisible="False" Visibility="Collapsed"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{DynamicResource ThemeSidebarColor}" Offset="0"/><GradientStop Color="{DynamicResource ThemeSidebarTransparentColor}" Offset="1"/></LinearGradientBrush></Border.Background></Border>
     <Border x:Name="SidebarBottomFade" Height="14" VerticalAlignment="Bottom" Margin="0,0,12,0" IsHitTestVisible="False" Visibility="Collapsed"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{DynamicResource ThemeSidebarTransparentColor}" Offset="0"/><GradientStop Color="{DynamicResource ThemeSidebarColor}" Offset="1"/></LinearGradientBrush></Border.Background></Border>
    </Grid>
    <StackPanel Grid.Row="2"><Button x:Name="SidebarCredentials" Content="Manage credentials" Style="{StaticResource SidebarButton}" Click="ManageCredentials_Click" FontSize="13" Margin="0,4,0,0"/><Button x:Name="AppearanceButton" Content="Appearance &amp; workspace" Style="{StaticResource SidebarButton}" Click="Appearance_Click" FontSize="13" Margin="0,4,0,0"/><Button x:Name="SettingsNavigationButton" Content="Storage &amp; Backup" Style="{StaticResource SidebarButton}" Click="Settings_Click" FontSize="13" Margin="0,4,0,10"/></StackPanel>
    <Border Grid.Row="3" BorderBrush="#34505E" BorderThickness="0,1,0,0" Padding="8,14,0,0"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource ThemeSidebarIcon}" Margin="0,0,8,0"/><TextBlock Text="Property management" Foreground="{DynamicResource ThemeSidebarMuted}" FontSize="12"/></StackPanel><TextBlock x:Name="AppVersionText" Text="Version · Workspace" Foreground="{DynamicResource ThemeSidebarMuted}" FontSize="11" Margin="15,7,0,0"/></StackPanel></Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="White" BorderBrush="#E2E9ED" BorderThickness="0,0,0,1" Padding="32,0"><Grid><TextBlock x:Name="WorkspaceBreadcrumb" Text="Workspace  /  Registry Sync" Foreground="#6B7D88" FontSize="12" VerticalAlignment="Center"/><Border Background="#EFF5F6" CornerRadius="12" Padding="12,5" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="PUBLIC SHOWCASE" FontSize="10" Foreground="#54717E" FontWeight="SemiBold"/></Border></Grid></Border>
   <ScrollViewer x:Name="WorkspaceScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,27,32,28">
     <TextBlock Text="Registry Sync" FontSize="30" FontWeight="SemiBold"/>
     <TextBlock x:Name="LastSync" Text="No completed sync yet" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,-22,0,8"/><TextBlock Text="Keep your cheque registry in step with Yardi P2P." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,6,0,22"/>
     <Border Background="#EAF5F3" BorderBrush="#CDE7E1" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,22"><StackPanel Orientation="Horizontal"><Path Data="M 12,2 A 10,10 0 1 1 12,22 A 10,10 0 1 1 12,2 M 12,10 L 12,17 M 12,6 L 12,7" Width="18" Height="18" Stretch="Uniform" Stroke="#287569" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,0,12,0"/><TextBlock Text="Close the workbook in Excel before syncing. A backup is created before any changes are saved." Foreground="#356C65" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
     <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="20,16"><StackPanel><TextBlock Text="RECORDS REVIEWED" Style="{StaticResource Caption}" FontSize="10"/><TextBlock x:Name="ReviewedCount" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="From the current sync run" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16"><StackPanel><TextBlock Text="CHANGED ROWS" Style="{StaticResource Caption}" FontSize="10"/><TextBlock x:Name="UpdatedCount" Text="—" FontSize="28" Foreground="#168271" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Saved when the sync completes" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,16"><StackPanel><TextBlock Text="NEEDS ATTENTION" Style="{StaticResource Caption}" FontSize="10"/><TextBlock x:Name="AttentionCount" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Records to check manually" Style="{StaticResource Caption}"/></StackPanel></Border>
     </Grid>
     <StackPanel Margin="2,2,2,20">
      <Grid><TextBlock x:Name="RunStatus" Text="Ready to sync" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="ProgressMeta" Text="" Foreground="#667985" FontSize="12" HorizontalAlignment="Right"/></Grid>
      <TextBlock x:Name="StageText" Text="Choose your registry workbook, then select Start sync." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,12"/>
      <ProgressBar x:Name="RunProgress" Height="6" Minimum="0" Maximum="100" Value="0" Background="#E2E9ED" BorderThickness="0"/>
     </StackPanel>
     <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Your registry workbook" FontSize="17" FontWeight="SemiBold"/>
       <TextBlock Text="Choose the Excel file you normally use for payment tracking." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,18"/>
       <Border Background="#F7F9FA" BorderBrush="#DCE5E9" BorderThickness="1" CornerRadius="8" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="WorkbookIcon" Width="28" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform" AutomationProperties.Name="Excel workbook file icon"/><StackPanel Grid.Column="1"><TextBlock x:Name="WorkbookName" Text="No workbook selected" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="WorkbookPath" Text="Excel workbook (.xlsx or .xlsm)" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></Grid></Border>
       <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Height="44" x:Name="BrowseButton" Content="Browse files" Click="Browse_Click"/><Button x:Name="OpenRegistryButton" Content="Open file" Click="OpenRegistry_Click" Height="44" IsEnabled="False" Margin="8,0,0,0"/><TextBlock Text="Select a registry to begin" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
       <StackPanel x:Name="RegistryBackupFolderControls" Margin="0,18,0,0"><TextBlock Text="Registry backup folder" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="RegistryBackupFolderPath" Text="Registry Backups beside the selected workbook" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,7,0,10"/><WrapPanel><Button Content="Change folder" Click="ChangeBackupFolder_Click" Padding="12,8" Margin="0,0,8,0"/><Button x:Name="DefaultBackupFolderButton" Content="Use default" Click="DefaultBackupFolder_Click" Padding="12,8" IsEnabled="False"/></WrapPanel><TextBlock Text="Applies to future Registry Sync backups. Existing backups stay where they are." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>

      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Ready when you are" FontSize="17" FontWeight="SemiBold"/>
       <TextBlock Text="Your saved session is checked first. A browser opens only when Yardi requires sign-in or verification." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,17"/>
       <Border Background="#FFF6E6" CornerRadius="6" Padding="10,7" HorizontalAlignment="Left"><TextBlock x:Name="ConnectionStatus" Text="Saved session checked at sync" FontSize="11" Foreground="#8D6926"/></Border>
       <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions><Button x:Name="SyncButton" IsEnabled="False" Height="44" Content="Start sync  →" Background="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}" BorderBrush="{DynamicResource ThemeAccent}" HorizontalAlignment="Stretch" Click="Sync_Click"/><Button Grid.Column="1" x:Name="CancelButton" Content="Cancel" Height="44" Padding="10,8" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click"/></Grid>
      </StackPanel></Border>
     </Grid>
     <Expander x:Name="LoginPanel" Header="Yardi sign-in (optional)" FontSize="13" Foreground="#29414F" Margin="2,0,2,20">
      <StackPanel Margin="0,14,0,0">
       <CheckBox x:Name="UseAutofill" Content="Fill my Yardi username and password" Checked="Autofill_Changed" Unchecked="Autofill_Changed" Margin="0,0,0,12"/>
       <Grid x:Name="LoginFields" IsEnabled="False" MaxWidth="650" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="20"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Username / email" Style="{StaticResource Caption}"/>
        <TextBlock Grid.Column="2" Text="Password" Style="{StaticResource Caption}"/>
        <TextBox TextChanged="SavedPassword_Changed" x:Name="LoginUsername" AutomationProperties.Name="Yardi username or email" Grid.Row="1" Padding="10,8" Margin="0,6,0,10" FontSize="14"/>
        <Grid Grid.Row="1" Grid.Column="2" Margin="0,6,0,10"><PasswordBox x:Name="LoginPassword" AutomationProperties.Name="Yardi password" Padding="10,8" FontSize="14" PasswordChanged="SavedPassword_Changed"/><TextBlock x:Name="SavedPasswordIndicator" Text="&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;  Saved" Foreground="#667985" Margin="12,0" VerticalAlignment="Center" FontSize="14" IsHitTestVisible="False" Visibility="Collapsed" AutomationProperties.Name="Password saved securely for this username"/></Grid>
        <CheckBox x:Name="RememberLogin" Grid.Row="2" Grid.ColumnSpan="3" Content="Remember securely for this Windows account after sign-in" FontSize="12"/>
       </Grid>
       <TextBlock x:Name="AutofillStatus" Text="Autofill submits Log in once. Complete verification yourself; Elevate (Production) is selected automatically." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
     <Button Content="Manage credentials" Click="ManageCredentials_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
       <Button x:Name="ForgetLoginButton" Content="Forget saved login" Click="ForgetLogin_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,12,0,0"/>
      </StackPanel>
     </Expander>
     <Button x:Name="BackupButton" Content="Show original backup" Click="Backup_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,20"/>
     <Border x:Name="AttentionPanel" Style="{StaticResource Card}" Visibility="Collapsed">
      <StackPanel>
       <DockPanel><DockPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><Button Content="Enlarge preview" preview:TablePreview.Target="{Binding ElementName=ResultsGrid}" preview:TablePreview.Title="Registry Sync - rows needing attention" Padding="10,6" Margin="8,0,0,0"/></DockPanel><TextBlock x:Name="AttentionTitle" Text="Rows needing attention" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
       <TextBlock x:Name="AttentionDescription" Text="Only flagged rows are listed below. Use the sheet and row number to find each record in Excel." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,18"/>
       <TextBlock x:Name="NoAttentionText" Text="All reviewed rows completed without a review flag." Foreground="#168271" Visibility="Collapsed" TextWrapping="Wrap"/>
       <DataGrid x:Name="ResultsGrid" MaxHeight="440" RowHeight="NaN" MinRowHeight="48" SelectionMode="Single" Visibility="Collapsed">
        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Reason}"/></Style></DataGrid.RowStyle>
        <DataGrid.Columns>
         <DataGridTemplateColumn Header="SHEET / ROW" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Location}" TextWrapping="Wrap" Margin="0,12" FontSize="12"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="VENDOR" Width="165"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Vendor}" TextWrapping="Wrap" Margin="0,12" FontSize="12"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="INVOICE" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Invoice}" TextWrapping="Wrap" Margin="0,12" FontSize="12"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTextColumn Header="PO" Binding="{Binding PO}" Width="75"/>
         <DataGridTextColumn Header="IR" Binding="{Binding IR}" Width="75"/>
         <DataGridTemplateColumn Header="REASON" Width="*" MinWidth="230"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,12" FontSize="12"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
      </StackPanel>
     </Border>
     <TextBlock Text="Existing registry rules are preserved. No purchase orders or invoices are created in Yardi." Style="{StaticResource Caption}" FontSize="11" Margin="2,16,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </ScrollViewer>
   <ContentControl x:Name="PersonalizedEmailHost" Grid.Row="1" Visibility="Collapsed"/>
   <ContentControl x:Name="OperationsHost" Grid.Row="1" Visibility="Collapsed"/>
   <ContentControl x:Name="OutlookSyncHost" Grid.Row="1" Visibility="Collapsed"/>
   <ContentControl x:Name="EnvelopeHost" Grid.Row="1" Visibility="Collapsed"/>
   <ContentControl x:Name="BuildingLinkHost" Grid.Row="1" Visibility="Collapsed"/>
   <ContentControl x:Name="OwnerMailingHost" Grid.Row="1" Visibility="Collapsed"/>
   <ContentControl x:Name="EmailListHost" Grid.Row="1" Visibility="Collapsed"/>
  </Grid>
 </Grid>
</Window>






