<UserControl x:Class="PropertyManager.App.Operations.OperationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:preview="clr-namespace:PropertyManager.App.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource ThemePage}">
 <Grid Margin="32,26,32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Reservations &amp; Reminders" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Refresh bookings, review repair and bulk requests, and prepare your operations reminder." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,12,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Manage credentials" Click="Credentials_Click" Margin="0,0,8,0"/><Button x:Name="HistoryNavigationButton" Content="View history" Click="HistoryNavigation_Click"/></StackPanel></Grid>
  <Border x:Name="ActionCard" Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,18"><StackPanel><WrapPanel><Button x:Name="RefreshButton" Content="Refresh &amp; preview" Click="Refresh_Click" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}" Padding="14,9" Margin="0,0,8,8"/><Button x:Name="EmailPreviewButton" Content="Preview email" Click="EmailPreview_Click" IsEnabled="False" Padding="12,9" Margin="0,0,8,8"/><Button x:Name="SendButton" Content="Send reminder" Click="Send_Click" IsEnabled="False" Padding="12,9" Margin="0,0,8,8"/><Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" Padding="12,9" Margin="0,0,0,8"/></WrapPanel><ProgressBar x:Name="Progress" Height="5" Margin="0,4,0,10" Minimum="0" Maximum="100"/><TextBlock x:Name="StatusText" Text="Choose your operations workbook and save settings to begin. No email is sent by Refresh &amp; preview." Style="{StaticResource Caption}" TextWrapping="Wrap"/><TextBlock x:Name="SummaryText" Text="Refresh to prepare the reminder. Open the Excel workbook to review its records." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="WarningText" Foreground="#9B5B14" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
  <ScrollViewer x:Name="FeatureScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0"><StackPanel>
   <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,18"><StackPanel x:Name="WorkbookPanel">
    <TextBlock Text="Your operations workbook" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="Choose the Excel file used for amenity bookings, repair cases and bulk-item requests." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,16"/>
    <Border Background="#F7F9FA" BorderBrush="#DCE5E9" BorderThickness="1" CornerRadius="8" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="WorkbookIcon" Width="28" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform" AutomationProperties.Name="Excel workbook file icon"/><StackPanel Grid.Column="1"><TextBlock x:Name="WorkbookName" Text="No workbook selected" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="WorkbookPath" Text="Excel workbook (.xlsx)" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></Grid></Border>
    <WrapPanel Margin="0,16,0,0"><Button Content="Browse files" Click="Browse_Click" Height="44" Margin="0,0,8,0"/><Button x:Name="OpenWorkbookButton" Content="Open file" Click="OpenWorkbook_Click" Height="44" IsEnabled="False"/></WrapPanel>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,18"><Expander x:Name="SetupExpander" Header="BuildingLink and reminder settings" IsExpanded="True"><StackPanel x:Name="SetupPanel" Margin="0,14,0,0">

    <TextBlock Text="Shared reservation calendar: DEMO 1001" FontWeight="SemiBold" Margin="0,14,0,7"/><TextBlock Text="Includes DEMO 2002 and DEMO 1001 bookings. Each reservation's details are checked to identify the resident's corporation." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
    <StackPanel Margin="0,14,0,0" HorizontalAlignment="Left"><TextBlock Text="Days ahead" Style="{StaticResource Caption}" Margin="0,0,0,7"/><TextBox x:Name="DaysText" Width="130" Padding="8" TextChanged="Changed"/></StackPanel>
    <TextBlock Text="Includes Requested and Approved bookings for all amenities, open repair cases, and open bulk-item requests. Updates the booking worksheet after a successful refresh." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,8"/>
    <TextBlock Text="The date range includes today through the selected days ahead, using Example City dates. Booking failures preserve previous Excel bookings. Successful saves retain one recovery copy beside the workbook. Refresh &amp; preview does not send an email." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
    <Button Content="Set up reminder email" Click="Credentials_Click" HorizontalAlignment="Left" Margin="0,14,0,8"/>
     <CheckBox x:Name="PartialCheck" Content="Allow sending reminders with extraction, workbook or missing-sheet warnings" Checked="Changed" Unchecked="Changed" Margin="0,14,0,6"/><TextBlock Text="Warnings appear in the email. Keep this off to stop scheduled sending when any section is incomplete. Configure the email server, recipients and saved login under Manage credentials > Email sending." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,16,0,0"><Button Content="Save settings" Click="Save_Click" Margin="0,0,8,0"/><Button Content="Import previous settings" Click="Import_Click"/></WrapPanel><TextBlock x:Name="CredentialText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
   </StackPanel></Expander></Border>
   <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,18"><StackPanel x:Name="SchedulePanel"><TextBlock Text="Automatic reminders" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Runs under this Windows account while signed in, using the computer's Windows clock. A missed run can start when the computer becomes available. One scheduled attempt per Example City day; emails are never retried automatically." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,12"/>
    <WrapPanel><TextBlock Text="Time (HH:mm)" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="TimeText" Width="75" Padding="7" Margin="0,0,16,0"/><WrapPanel x:Name="ScheduleDays" VerticalAlignment="Center"/></WrapPanel>
    <WrapPanel Margin="0,14,0,0"><Button Content="Enable / change schedule" Click="EnableSchedule_Click" Margin="0,0,8,8"/><Button Content="Disable schedule" Click="DisableSchedule_Click" Margin="0,0,8,8"/><Button Content="Check schedule" Click="CheckSchedule_Click" Margin="0,0,8,8"/><Button Content="Open Task Scheduler" Click="TaskScheduler_Click" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="ScheduleText" Text="Check schedule to see enabled and older reminder tasks." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
   </StackPanel></Border>

  </StackPanel></ScrollViewer>
   <Border x:Name="HistoryPanel" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Top" Style="{StaticResource Card}" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><DockPanel><Button Content="Refresh history" Click="History_Click" DockPanel.Dock="Right"/><DockPanel DockPanel.Dock="Right"><Button Content="Enlarge preview" preview:TablePreview.Target="{Binding ElementName=HistoryGrid}" preview:TablePreview.Title="Reservations and Reminders - run history" Padding="10,6" Margin="8,0,0,0"/></DockPanel><TextBlock Text="Run history" FontSize="18" FontWeight="SemiBold"/></DockPanel><TextBlock Text="Encrypted for this Windows account. An interrupted Running or Submitting run requires review before retrying; mail-server acceptance does not confirm delivery." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,10"/><DataGrid x:Name="HistoryGrid" Height="230" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Example City TIME" Binding="{Binding LocalTime}" Width="170"/><DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="140"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*"/></DataGrid.Columns></DataGrid><Button Content="View selected run" Click="RunDetails_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></ScrollViewer></Border>
 </Grid>
</UserControl>