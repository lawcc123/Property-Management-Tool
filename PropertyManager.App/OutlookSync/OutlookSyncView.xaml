<UserControl SizeChanged="View_SizeChanged" x:Class="PropertyManager.App.OutlookSync.OutlookSyncView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:email="clr-namespace:PropertyManager.App.EmailLists" xmlns:outlook="clr-namespace:PropertyManager.App.OutlookSync" xmlns:preview="clr-namespace:PropertyManager.App.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><outlook:OutlookPageHeightConverter x:Key="OutlookPageHeight"/></UserControl.Resources>
 <ScrollViewer x:Name="PageViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><Grid Margin="32,26,32,24"><Grid.Height><MultiBinding Converter="{StaticResource OutlookPageHeight}"><Binding ElementName="PageViewport" Path="ViewportHeight"/><Binding ElementName="PageHeading" Path="ActualHeight"/><Binding ElementName="SetupCard" Path="ActualHeight"/><Binding ElementName="SetupCard" Path="Visibility"/></MultiBinding></Grid.Height><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="PageHeading" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Outlook Contact Sync" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Update contacts and groups for all configured corporations in one click." Style="{StaticResource Caption}" Margin="0,7,12,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="HistoryNavigationButton" Grid.Column="1" Content="View history" Click="History_Click" VerticalAlignment="Center"/></Grid>
  <Border x:Name="SetupCard" Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,18"><StackPanel>
   <WrapPanel x:Name="QuickActions"><Button x:Name="UpdateAllButton" Content="Update all corporations" Click="UpdateAll_Click" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}" Padding="16,10" Margin="0,0,10,8"/><Button Content="Update settings" Click="UpdateSettings_Click" Padding="14,10" Margin="0,0,0,8"/></WrapPanel>
   <Border x:Name="DestinationSetupNotice" Background="#FFF7E7" BorderBrush="#E8C77B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10"><TextBlock Text="First-time setup: connect to Classic Outlook, choose your working Contacts folder, then click Save destination before updating." TextWrapping="Wrap"/></Border>
   <TextBlock x:Name="QuickDestinationText" Text="Set your Contacts destination once in Update settings." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,10"/>
   <Expander x:Name="SetupExpander" Header="Destination and update settings" IsExpanded="False"><StackPanel Margin="0,12,0,0">
   <TextBlock Text="Corporations included in Update all" FontWeight="SemiBold" Margin="0,0,0,8"/><WrapPanel x:Name="QuickCorporations" Margin="0,0,0,12"/>
   <TextBlock Text="Routine updates include app-created contact deletions and removal of group members. First-time changes to personal contacts or groups need approval. Group deletions require review." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <StackPanel x:Name="SettingsPanel"><TextBlock Text="Outlook mailbox / Contacts folder" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="MailboxCombo" DisplayMemberPath="Label" SelectionChanged="Selection_Changed" PreviewMouseWheel="IgnoreWheel" Padding="8"/><WrapPanel Margin="0,8,0,0"><Button Content="Connect to Classic Outlook" Click="Connect_Click" Padding="10,6" Margin="0,0,8,8"/><Button x:Name="SaveDestinationButton" Content="Save destination" Click="SaveDestination_Click" Padding="10,6" Margin="0,0,8,8"/><Button Content="Manage corporations" Click="ManageFolders_Click" Padding="10,6" Margin="0,0,0,8"/></WrapPanel></StackPanel>
   <TextBlock x:Name="SourceText" Text="The latest Occupant Data workbook is loaded automatically for each included corporation." Style="{StaticResource Caption}" Margin="0,14,0,8" TextWrapping="Wrap"/>
   <WrapPanel x:Name="ActionsPanel"><Button Content="Group settings..." Click="GroupSettings_Click" Padding="14,9" Margin="0,0,8,8"/></WrapPanel>
   </StackPanel></Expander>
   <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="4" Margin="0,4,0,8" Visibility="Collapsed"/>
   <TextBlock x:Name="StatusText" Text="First time: open Update settings, connect to Outlook and save your working Contacts destination." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
   <Expander x:Name="ErrorActions" Header="Troubleshooting" IsExpanded="False" Visibility="Collapsed" Margin="0,10,0,0"><StackPanel Margin="0,8,0,0"><TextBlock Text="Export a diagnostic report to help investigate this error. Review the report before sharing it." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/><WrapPanel><Button x:Name="RawErrorButton" Visibility="Collapsed" Content="View error details" Click="ErrorDetails_Click" Padding="10,6" Margin="0,0,8,0"/><Button x:Name="ExportDiagnosticButton" Content="Export diagnostic report" Click="ExportError_Click" Padding="10,6"/></WrapPanel></StackPanel></Expander>
   <Button x:Name="CancelButton" Content="Cancel after current item" Click="Cancel_Click" Visibility="Collapsed" HorizontalAlignment="Left" Padding="10,6" Margin="0,8,0,0"/>
  </StackPanel></Border>
  <Border x:Name="PreviewPanel" Grid.Row="2" Style="{StaticResource Card}" Padding="16"><Grid x:Name="PreviewContent"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel><Button x:Name="EnlargePreviewButton" Content="Enlarge preview" Click="EnlargePreview_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="10,5"/><ComboBox x:Name="PreviewFilter" SelectedIndex="0" SelectionChanged="PreviewFilter_Changed" PreviewMouseWheel="IgnoreWheel" HorizontalAlignment="Right" MinWidth="155" Padding="6" Margin="8,0,8,0" DockPanel.Dock="Right"><ComboBoxItem Content="All changes"/><ComboBoxItem Content="Individual contacts"/><ComboBoxItem Content="Contact groups"/></ComboBox><TextBlock Text="Review changes" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <StackPanel Grid.Row="1" Margin="0,8,0,12"><TextBlock x:Name="SummaryText" Text="Your preview will appear here." Style="{StaticResource Caption}" TextWrapping="Wrap"/><TextBlock x:Name="ReviewInstructions" Text="Approving an existing personal contact updates both its filing name and email display label. Actual names, email addresses, phones and notes are preserved." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
   <DataGrid x:Name="ChangesGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" IsReadOnly="False" MinRowHeight="44" RowHeight="NaN" HorizontalScrollBarVisibility="Auto" CellEditEnding="EditEnding">
    <DataGrid.Resources><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="6,0"/><Setter Property="FontSize" Value="10"/></Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGrid.Resources>
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="APPROVE" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanApply}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="CORPORATION" Binding="{Binding Corporation}" IsReadOnly="True" Width="100"/>
     <DataGridTextColumn Header="TYPE" Binding="{Binding ItemKind}" IsReadOnly="True" Width="75"/>
     <DataGridTextColumn Header="ACTION" Binding="{Binding Action}" IsReadOnly="True" Width="95"/>
     <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" IsReadOnly="True" Width="140"/>
     <DataGridTextColumn Header="REASON" Binding="{Binding Reason}" IsReadOnly="True" Width="*" MinWidth="130"/>
     <DataGridTextColumn Header="PROPOSED UNIT / NAME" Binding="{Binding ProposedName}" IsReadOnly="True" Width="*" MinWidth="130"/>
    </DataGrid.Columns>
   </DataGrid>
   <WrapPanel Grid.Row="3" Margin="0,14,0,0"><Button x:Name="ApplyButton" Content="Apply selected changes" IsEnabled="False" Click="Apply_Click" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}" Padding="14,9" Margin="0,0,8,8"/><Button Content="View details" Click="Details_Click" Padding="12,9" Margin="0,0,8,8"/><Button Content="Select all" Click="SelectAll_Click" ToolTip="Approve all eligible displayed changes. Hidden rows keep their existing selections; Apply includes selected rows in every filter." Padding="12,9" Margin="0,0,8,8"/><Button Content="Select recommended" Click="SelectRecommended_Click" Padding="12,9" Margin="0,0,8,8"/><Button Content="Clear selection" Click="Clear_Click" Padding="12,9" Margin="0,0,0,8"/></WrapPanel>
  </Grid></Border>
  <Border x:Name="HistoryPanel" VerticalAlignment="Top" Grid.Row="2" Style="{StaticResource Card}" Padding="20" Visibility="Collapsed"><ScrollViewer x:Name="HistoryViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0"><StackPanel>
   <DockPanel><DockPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><Button Content="Enlarge preview" preview:TablePreview.Target="{Binding ElementName=HistoryGrid}" preview:TablePreview.Title="Outlook sync history and recovery" Padding="10,6" Margin="8,0,0,0"/></DockPanel><TextBlock Text="Sync history and recovery" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="HistoryContextText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/><StackPanel><TextBlock Text="Protected for this Windows account. Retains recovery history for full undo, including original values and subsequent writes. Older installations may have gaps from previously expired runs." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,12"/></StackPanel>
   <StackPanel Margin="0,0,0,12"><WrapPanel><TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,7,8"/><DatePicker x:Name="HistoryFromDate" SelectedDateChanged="HistoryDate_Changed" Width="140" Margin="0,0,12,8" AutomationProperties.Name="Sync history from date"/><TextBlock Text="Through" VerticalAlignment="Center" Margin="0,0,7,8"/><DatePicker x:Name="HistoryToDate" SelectedDateChanged="HistoryDate_Changed" Width="140" Margin="0,0,12,8" AutomationProperties.Name="Sync history through date"/><Button Content="Clear dates" Click="ClearHistoryDates_Click" Padding="12,7" Margin="0,0,8,8"/><Button Content="Refresh" Click="RefreshHistory_Click" Padding="12,7" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="HistorySummary" Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel>
   <DataGrid x:Name="HistoryGrid" Height="360" MinHeight="150" MinRowHeight="44" HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Example City TIME" Binding="{Binding LocalTime}" Width="150"/><DataGridTextColumn Header="CORPORATION" Binding="{Binding Corporation}" Width="130"/><DataGridTextColumn Header="MODE" Binding="{Binding Mode}" Width="145"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="160"/><DataGridTextColumn Header="MAILBOX" Binding="{Binding Mailbox}" Width="*"/></DataGrid.Columns></DataGrid>
   <WrapPanel x:Name="HistoryActions" Margin="0,14,0,0"><Button Content="View recovery details" Click="RunDetails_Click" Padding="12,9" Margin="0,0,8,8"/><Button Content="Restore selected run" Click="Restore_Click" Padding="12,9" Margin="0,0,8,8"/><Button Content="Export report" Click="Export_Click" Padding="12,9" Margin="0,0,8,8"/><Button Content="Export full item backups" Click="ExportBackups_Click" Padding="12,9" Margin="0,0,8,8"/></WrapPanel>
   <Expander x:Name="AdvancedCleanup" Header="Advanced cleanup" Margin="0,12,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="Restore recorded app changes for all corporations in the selected Contacts folder. Review the undo preview before applying; missing history and conflicting edits are left unchanged." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/><WrapPanel><Button Content="Undo all app changes in this Contacts folder..." Click="FullUndo_Click" Padding="12,9" Margin="0,0,8,8"/></WrapPanel></StackPanel></Expander>
  </StackPanel></ScrollViewer></Border>
 </Grid></ScrollViewer>
</UserControl>
