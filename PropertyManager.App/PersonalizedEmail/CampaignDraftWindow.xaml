<Window x:Class="PropertyManager.App.PersonalizedEmail.CampaignDraftWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Open draft - Personalized Email" Width="1060" Height="660" MinWidth="820" MinHeight="520" WindowStartupLocation="CenterOwner" Background="{DynamicResource ThemePage}" Foreground="#172B3A">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="Saved email drafts" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Open a draft to continue, or remove saved drafts you no longer need. Secured for this Windows account." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,12"><Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="Search drafts" DockPanel.Dock="Left" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="SearchText" Padding="10" TextChanged="Search_Changed" ToolTip="Search draft name or subject" AutomationProperties.Name="Search drafts by name or subject"/></DockPanel>
   <TextBlock x:Name="CountText" Grid.Row="1" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
   <Grid Grid.Row="2"><DataGrid x:Name="DraftGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="Selection_Changed" MouseDoubleClick="Draft_DoubleClick" MinRowHeight="44" HorizontalScrollBarVisibility="Auto"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Status}"/></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="DRAFT NAME" Binding="{Binding Title}" Width="2*" MinWidth="170"/><DataGridTextColumn Header="SUBJECT" Binding="{Binding Subject}" Width="2*" MinWidth="150"/><DataGridTextColumn Header="SAVED (Example City)" Binding="{Binding SavedLocal}" Width="155"/><DataGridTextColumn Header="RECIPIENTS" Binding="{Binding Recipients}" Width="100"/><DataGridTextColumn Header="FILES" Binding="{Binding Documents}" Width="60"/><DataGridTextColumn Header="STATUS" Binding="{Binding Availability}" Width="*" MinWidth="100"/></DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyText" Text="No saved drafts yet. Use Save draft to keep your work." Style="{StaticResource Caption}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False"/></Grid>
   <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0" Text="Deleting a draft leaves its attachments and source workbooks untouched. Ctrl+click or Shift+click to select multiple drafts."/>
  </Grid></Border>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="DeleteButton" Content="Delete selected" Click="Delete_Click" Foreground="#B34040" HorizontalAlignment="Left" IsEnabled="False"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Close" Click="Close_Click" Margin="0,0,8,0" IsCancel="True"/><Button x:Name="OpenButton" Content="Open draft" Click="Open_Click" IsEnabled="False" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}"/></StackPanel></Grid>
 </Grid>
</Window>
