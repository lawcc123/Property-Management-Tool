<UserControl x:Class="PropertyManager.App.PersonalizedEmail.PersonalizedEmailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:preview="clr-namespace:PropertyManager.App.Controls">
 <Grid Margin="32,26,32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*" MaxWidth="660"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Personalized Email" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock Text="Choose your recipients, write once, and review a personal message for each unit." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,12,0"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><Button x:Name="EmailAccountSettingsButton" Content="Email account settings" Click="Account_Click" Padding="12,8" Margin="0,0,8,8"/><Button x:Name="NewDraftButton" Content="New draft" Click="NewDraft_Click" Padding="12,8" Margin="0,0,8,8"/><Button x:Name="OpenDraftButton" Content="Open draft" ToolTip="View, open or delete saved email drafts" Click="OpenDraft_Click" Padding="12,8" Margin="0,0,8,8"/><Button x:Name="SaveDraftButton" Content="Save draft" Click="SaveDraft_Click" Padding="12,8" Margin="0,0,8,8"/><Button x:Name="HistoryNavigationButton" Content="View history" Click="DeliveryHistory_Click" Padding="12,8" Margin="0,0,0,8"/></WrapPanel></Grid>
  <StackPanel Grid.Row="1"><TextBlock x:Name="SentCompletionNotice" Visibility="Collapsed" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBox x:Name="TitleText" Visibility="Collapsed"/><TextBlock x:Name="DraftNameText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><Border Background="#FFF7E8" BorderBrush="#F0DEB4" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"><TextBlock Text="Prepare and review messages before sending. Test emails go only to your test inbox; live emails require a separate confirmation." Foreground="#795619" FontSize="12" TextWrapping="Wrap"/></Border></StackPanel>
  <Border x:Name="DraftStartPanel" Grid.Row="2" Style="{StaticResource Card}" Padding="28" VerticalAlignment="Top"><StackPanel><TextBlock Text="Start with a named draft" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Create a new draft or open a saved draft before choosing recipients. Your message, recipient snapshot and attachment choices are saved together." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,20"/><WrapPanel><Button Content="Create new draft" Click="NewDraft_Click" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}" Padding="16,10" Margin="0,0,10,0"/><Button Content="Open saved draft" Click="OpenDraft_Click" Padding="16,10"/></WrapPanel></StackPanel></Border>
  <TabControl x:Name="Steps" Grid.Row="2" Style="{StaticResource FeatureTabs}" SelectionChanged="Step_Changed"><TabControl.ItemContainerStyle><Style TargetType="TabItem" BasedOn="{StaticResource FeatureTab}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger></Style.Triggers></Style></TabControl.ItemContainerStyle>
   <TabItem Header="1  Recipients"><ScrollViewer Foreground="#172B3A" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0"><StackPanel>
    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"><StackPanel><TextBlock Text="Who is this notice for?" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Use the same corporation folders and group filters as Generate Email List, or bring your own spreadsheet." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,16"/><WrapPanel><Button Content="Generate from BuildingLink data" Click="GenerateList_Click" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}" Padding="14,10" Margin="0,0,8,8"/><Button Content="Import Excel / CSV" Click="Import_Click" Padding="14,10" Margin="0,0,8,8"/><Button x:Name="SampleDataButton" Visibility="Collapsed" Content="Try sample data" Click="Sample_Click" Padding="14,10" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="SourceText" Text="No recipient list selected." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
     <Grid x:Name="MappingPanel" Visibility="Collapsed" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Email column" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ComboBox x:Name="EmailColumn" SelectionChanged="Mapping_Changed" PreviewMouseWheel="IgnoreWheel" Padding="8"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Unit column" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ComboBox x:Name="UnitColumn" SelectionChanged="Mapping_Changed" PreviewMouseWheel="IgnoreWheel" Padding="8"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Name column" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ComboBox x:Name="NameColumn" SelectionChanged="Mapping_Changed" PreviewMouseWheel="IgnoreWheel" Padding="8"/></StackPanel></Grid>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Padding="20"><StackPanel><DockPanel><Button x:Name="EditRecipientDataButton" Content="Edit recipient data" Click="EditRecipientData_Click" DockPanel.Dock="Right" Padding="10,6"/><TextBlock Text="Recipient snapshot" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="RecipientSummary" Text="Your recipients will appear here." Style="{StaticResource Caption}" Margin="0,8,0,12"/><DataGrid x:Name="RecipientGrid" Height="290" IsReadOnly="False" AutoGenerateColumns="False" CellEditEnding="Recipient_EditEnding" MouseDoubleClick="Recipient_DoubleClick"><DataGrid.Columns><DataGridTemplateColumn Header="INCLUDE" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Included,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn x:Name="RecipientCorporationColumn" Header="CORPORATION" Binding="{Binding Corporation}" Width="120"/><DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="75"/><DataGridTextColumn Header="NAMES" Binding="{Binding Names}" Width="*" MinWidth="130"/><DataGridTextColumn Header="EMAIL (EDITABLE)" Binding="{Binding Email}" Width="*" MinWidth="160"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" IsReadOnly="True" Width="110"/></DataGrid.Columns></DataGrid><TextBlock Text="The same email can receive notices for different units. Missing-email rows remain in your draft as print-only records. Source workbooks are never changed." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="2  Message"><ScrollViewer Foreground="#172B3A" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0"><StackPanel>
    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"><StackPanel><TextBlock Text="Your shared sender account" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="SenderText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,10,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="Write your message" FontSize="18" FontWeight="SemiBold"/><WrapPanel Margin="0,16,0,12"><TextBlock Text="Personalization field" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="FieldCombo" Width="200" Padding="8" PreviewMouseWheel="IgnoreWheel"/><Button Content="Insert at cursor" Click="InsertField_Click" Padding="12,8" Margin="8,0,0,0"/></WrapPanel><TextBlock Text="Click in the subject, message or signature first, then choose a field. The review step shows real values for each recipient." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/><TextBlock Text="Subject" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBox x:Name="SubjectText" Padding="10" GotFocus="MergeTarget_Focus"/><TextBlock Text="Message" Style="{StaticResource Caption}" Margin="0,16,0,6"/><TextBox x:Name="BodyText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="200" Padding="12" GotFocus="MergeTarget_Focus"/><DockPanel Margin="0,16,0,8"><Button Content="Manage signatures" Click="ManageSignatures_Click" DockPanel.Dock="Right" Padding="12,8"/><TextBlock Text="Email signature" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ComboBox x:Name="SignatureChoiceCombo" DisplayMemberPath="Name" SelectionChanged="SignatureChoice_Changed" Padding="9" Margin="0,0,0,10" PreviewMouseWheel="IgnoreWheel"/><RichTextBox x:Name="SignaturePreview" IsReadOnly="True" Height="190" VerticalScrollBarVisibility="Auto" BorderBrush="#DCE4E8" Background="White" Foreground="#172B3A"/><TextBox x:Name="SignatureText" Visibility="Collapsed"/><Button x:Name="UseSavedSignatureButton" Visibility="Collapsed" Click="UseSavedSignature_Click"/>
<TextBlock x:Name="SignatureHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="3  Documents &amp; attachments"><ScrollViewer Foreground="#172B3A" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0"><StackPanel>
    <Border Style="{StaticResource Card}" Padding="20"><StackPanel><DockPanel><Button Content="Enlarge preview" preview:TablePreview.Target="{Binding ElementName=DocumentsGrid}" preview:TablePreview.Title="Personalized Email documents and attachments" DockPanel.Dock="Right" Padding="10,6"/><TextBlock Text="What should each email include?" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Add several Word templates for each unit, plus files everyone receives. Save only personalized Word/PDF files here, grouped into one folder per template. No email account is needed. Test and live sending prepare their attachments separately." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,16"/><WrapPanel Margin="0,0,0,12"><Button Content="Add Word templates" Click="AddTemplates_Click" Padding="12,9" Margin="0,0,8,8"/><Button Content="Add common files" Click="AddFiles_Click" Padding="12,9" Margin="0,0,8,8"/><Button Content="Remove selected" Click="RemoveDocument_Click" Padding="12,9" Margin="0,0,0,8"/></WrapPanel><DataGrid x:Name="DocumentsGrid" CellEditEnding="Document_EditEnding" IsReadOnly="False" AutoGenerateColumns="False" SelectionMode="Extended" Height="255"><DataGrid.Columns><DataGridTextColumn Header="FILE" Binding="{Binding FileName}" IsReadOnly="True" Width="*" MinWidth="150"/><DataGridTextColumn Header="FILE SIZE" Binding="{Binding SizeText}" Width="90" IsReadOnly="True"/><DataGridTemplateColumn Header="PERSONALIZE" Width="115"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Personalize,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsWord}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="OUTPUT" Width="115"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding Format,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsWord}" PreviewMouseWheel="IgnoreWheel" Padding="6"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="OUTPUT NAME (WITHOUT EXTENSION)" Width="1.3*" MinWidth="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><TextBox x:Name="OutputNameEditor" Text="{Binding OutputName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Padding="6" BorderThickness="0" Background="Transparent"/><TextBlock x:Name="OriginalFileLabel" Text="Original file" VerticalAlignment="Center" Visibility="Collapsed" Foreground="#667985"/></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding RequiresGeneration}" Value="False"><Setter TargetName="OutputNameEditor" Property="Visibility" Value="Collapsed"/><Setter TargetName="OriginalFileLabel" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock x:Name="AttachmentSizeText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="Example: {{Unit}} - Notice becomes 518 - Notice.pdf. Give each template its own filename. Word generation requires desktop Microsoft Word; email-only sending does not." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,16"/><WrapPanel><Button Content="Check selected template fields" Click="CheckTemplate_Click" Padding="12,9" Margin="0,0,8,8"/><Button Content="Preview personalized text" Click="TemplatePreview_Click" Padding="12,9" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="TemplateStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/><Border BorderBrush="#DCE4E8" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0"><StackPanel><TextBlock Text="Save files for review or storage" FontSize="16" FontWeight="SemiBold"/><WrapPanel Margin="0,12,0,8"><Button x:Name="SaveAttachmentsButton" Content="Save generated attachments..." Click="SaveAttachments_Click" Padding="12,9" Margin="0,0,8,8"/><Button x:Name="OpenExportFolderButton" Content="Open folder" Click="OpenExportFolder_Click" IsEnabled="False" Padding="12,9" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="ExportFolderText" Style="{StaticResource Caption}" TextWrapping="Wrap"/><ProgressBar x:Name="ExportProgress" Height="5" Margin="0,10,0,0" Visibility="Collapsed"/></StackPanel></Border></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="4  Review &amp; test"><ScrollViewer Foreground="#172B3A" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0"><StackPanel>
    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"><StackPanel><TextBlock Text="Review the actual message for each unit" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Build previews; the first three messages are selected by default. Ctrl+click or Shift+click to choose 1-5 real messages for a test. Testing is optional. Continue to Send live emails when you are ready; the app will prepare all live messages there." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,14"/><CheckBox x:Name="TestMode" Visibility="Collapsed"/><WrapPanel><TextBlock Text="Test inbox" VerticalAlignment="Center" Margin="0,0,8,8"/><TextBox x:Name="TestInbox" Width="200" Padding="9" Margin="0,0,8,8" ToolTip="Only this inbox receives selected test messages"/><Button Content="Build previews" Click="BuildPreview_Click" Padding="12,9" Margin="0,0,8,8"/><Button x:Name="SendTestsButton" Content="Send selected tests (1-5)" Click="SendTests_Click" Padding="12,9" Margin="0,0,8,8"/><Button x:Name="DemoButton" Visibility="Collapsed" Content="Simulate sample" Click="Demo_Click"/></WrapPanel><ProgressBar x:Name="DemoProgress" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,4,0,8"/><TextBlock x:Name="ReviewSummary" Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel></Border>
    <Grid MinHeight="330"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Padding="14"><StackPanel><TextBlock Text="Messages (select 1-5 to test)" FontWeight="SemiBold" Margin="0,0,0,12"/><ListBox x:Name="PreviewList" SelectionMode="Extended" DisplayMemberPath="Label" SelectionChanged="Preview_Changed" Height="290" BorderThickness="0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,12"/></Style></ListBox.ItemContainerStyle></ListBox></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><StackPanel><WrapPanel Margin="0,0,0,12"><Button x:Name="PreviousPreviewButton" Content="Previous" Click="PreviousPreview_Click" IsEnabled="False" Padding="12,8" Margin="0,0,8,6"/><Button x:Name="NextPreviewButton" Content="Next" Click="NextPreview_Click" IsEnabled="False" Padding="12,8" Margin="0,0,12,6"/><TextBlock x:Name="PreviewPosition" Text="No preview records" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel><TextBlock x:Name="PreviewTo" Text="Select a preview to inspect its destination." Style="{StaticResource Caption}" TextWrapping="Wrap"/><TextBlock x:Name="PreviewSubject" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,16"/><TextBox x:Name="PreviewBody" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="0" MinHeight="130" MaxHeight="300" VerticalScrollBarVisibility="Auto" Background="Transparent"/><RichTextBox x:Name="HtmlMessagePreview" IsReadOnly="True" MinHeight="150" MaxHeight="380" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="White" Foreground="#172B3A"/><TextBlock Text="Attachments" FontWeight="SemiBold" Margin="0,16,0,8"/><ItemsControl x:Name="PreviewAttachments"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" CommandParameter="{Binding}" Click="OpenPreparedAttachment_Click" HorizontalAlignment="Left" Margin="0,0,0,6" Padding="10,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Preparation and previews do not send mail. Server acceptance does not confirm final delivery." Foreground="#94651A" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="5  Send live emails"><ScrollViewer Foreground="#172B3A" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0"><Border Style="{StaticResource Card}" Padding="24" VerticalAlignment="Top"><StackPanel><TextBlock Text="Send live emails" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Review and testing are separate from live delivery. Tests are optional. All messages and generated attachments must be prepared successfully before you can send." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,18"/><TextBlock x:Name="LiveSummary" Text="Continue from Review &amp; test to prepare your live messages." TextWrapping="Wrap" Margin="0,0,0,18"/><WrapPanel><Button x:Name="PrepareLiveButton" Content="Prepare / refresh live messages" Click="PrepareAll_Click" Padding="14,9" Margin="0,0,8,8"/><Button x:Name="SendLiveButton" Content="Send live emails" Click="SendLive_Click" IsEnabled="False" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}" Padding="14,9" Margin="0,0,0,8"/></WrapPanel><StackPanel x:Name="LiveProgressPanel" Visibility="Collapsed" Margin="0,16,0,0"><TextBlock Text="Live email progress" FontWeight="SemiBold"/><ProgressBar x:Name="LiveDeliveryProgress" Minimum="0" Maximum="100" Height="6" Margin="0,10,0,8"/><TextBlock x:Name="LiveProgressCount" Style="{StaticResource Caption}" TextWrapping="Wrap"/><TextBlock x:Name="LiveProgressStatus" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><TextBlock Text="Sending requires confirmation. Already accepted and uncertain submissions are skipped to avoid accidental duplicate emails. You can stop after the current message." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></Border></ScrollViewer></TabItem>
  </TabControl>
  <Border x:Name="DeliveryHistoryPanel" Grid.Row="2" Style="{StaticResource Card}" Padding="20" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel><Button Content="Refresh" Click="RefreshDeliveryHistory_Click" DockPanel.Dock="Right"/><TextBlock Text="Email sending history" FontSize="19" FontWeight="SemiBold"/></DockPanel>
   <TextBlock Grid.Row="1" Text="Test and live campaigns are separate. Accepted or uncertain messages are never resent automatically. History is encrypted for this Windows account; prepared attachment files remain in your local app-data folder." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,12"/>
   <DataGrid x:Name="DeliveryHistoryGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="DeliveryRun_Changed" MinHeight="100"><DataGrid.Columns><DataGridTextColumn Header="Example City TIME" Binding="{Binding LocalTime}" Width="155"/><DataGridTextColumn Header="DRAFT" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="TYPE" Binding="{Binding Mode}" Width="70"/><DataGridTextColumn Header="MESSAGES" Binding="{Binding Messages}" Width="90"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="2*"/></DataGrid.Columns></DataGrid>
   <DataGrid x:Name="DeliveryMessagesGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="DeliveryMessage_Changed" Margin="0,14,0,0" MinHeight="100" MouseDoubleClick="DeliveryDetails_Click"><DataGrid.Columns><DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="80"/><DataGridTextColumn Header="DESTINATION" Binding="{Binding To}" Width="*"/><DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="120"/><DataGridTextColumn Header="DETAILS" Binding="{Binding Detail}" Width="2*"/></DataGrid.Columns></DataGrid>
   <StackPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock x:Name="DeliverySelectionHint" Text="Select a campaign above, then a message below to view its details." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/><WrapPanel><Button x:Name="DeliveryDetailsButton" Content="View message details" Click="DeliveryDetails_Click" IsEnabled="False" Margin="0,0,8,0"/><Button Content="Send remaining / retry failures" Click="RetryDelivery_Click"/></WrapPanel></StackPanel>
  </Grid></Border>
  <Grid x:Name="WorkflowFooter" Grid.Row="3" Margin="0,16,0,0" PreviewMouseLeftButtonDown="DisabledContinue_Click"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Start by choosing your recipients." Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/><WrapPanel Grid.Column="1"><Button x:Name="StopDeliveryButton" Content="Stop after current email" Click="StopDelivery_Click" Visibility="Collapsed" Margin="0,0,8,0"/><Button x:Name="BackButton" Content="Back" Click="Back_Click" Padding="16,9" Margin="0,0,8,0"/><Button x:Name="NextButton" ToolTipService.ShowOnDisabled="True" Content="Continue" Click="Next_Click" Padding="16,9" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}"/></WrapPanel></Grid>
 </Grid>
</UserControl>
