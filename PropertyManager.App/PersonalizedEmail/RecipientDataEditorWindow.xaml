<Window x:Class="PropertyManager.App.PersonalizedEmail.RecipientDataEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Edit recipient data - Personalized Email" Width="1200" Height="780" MinWidth="840" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource ThemePage}" Foreground="#172B3A">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="Edit recipient data" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Edit this campaign's snapshot. Unit and Names stay visible as you scroll. Source workbooks are never changed." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <WrapPanel><Button Content="Add column" Click="AddColumn_Click" Margin="0,0,8,8"/><Button x:Name="ColumnsButton" Content="Choose columns" Click="Columns_Click" Margin="0,0,8,8"/><Button x:Name="EditRowButton" Content="Edit selected recipient" Click="EditRow_Click" Margin="0,0,8,8" IsEnabled="False"/><Button Content="Export to Excel" Click="Export_Click" Margin="0,0,8,8"/><Button Content="Import edited Excel" Click="Import_Click" Margin="0,0,0,8"/></WrapPanel>
   <TextBlock x:Name="CountText" Grid.Row="1" Style="{StaticResource Caption}" Margin="0,4,0,12"/>
   <DataGrid x:Name="EditorGrid" Grid.Row="2" AutoGenerateColumns="True" AutoGeneratingColumn="Column_Generating" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow" FrozenColumnCount="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinRowHeight="42" MouseDoubleClick="Row_DoubleClick" SelectionChanged="Selection_Changed"/>
   <TextBlock x:Name="StatusText" Grid.Row="3" Text="Double-click a recipient for a form with all fields. Excel imports match by Recipient ID, so sorting rows is safe. Keep those IDs unchanged." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </Grid></Border>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/><Button Content="Apply changes" Click="Apply_Click" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}"/></StackPanel>
 </Grid>
</Window>
