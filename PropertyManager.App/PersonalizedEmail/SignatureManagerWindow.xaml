<Window x:Class="PropertyManager.App.PersonalizedEmail.SignatureManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Manage email signatures" Width="1050" Height="760" MinWidth="880" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{DynamicResource ThemePage}" Foreground="#172B3A">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="Manage email signatures" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Create reusable HTML signatures with formatted text and embedded pictures. The built-in no-reply signature is always available." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="16"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><Button Content="New signature / copy" Click="New_Click" Padding="10,8" Margin="0,0,0,8"/><Button x:Name="DeleteButton" Content="Delete selected" Click="Delete_Click" Padding="10,8" Margin="0,0,0,8"/><Button Content="Set as default" Click="Default_Click" Padding="10,8"/><TextBlock x:Name="DefaultHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel><ListBox x:Name="SignatureList" DisplayMemberPath="Name" SelectionChanged="Selection_Changed" BorderThickness="0"/></DockPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Signature name" Style="{StaticResource Caption}"/><TextBox x:Name="NameText" Padding="9" Margin="0,6,0,12" MaxLength="80" TextChanged="Name_Changed"/></StackPanel>
    <StackPanel Grid.Row="1" x:Name="FormattingPanel"><WrapPanel Margin="0,0,0,8"><ComboBox x:Name="FontCombo" Width="125" SelectedIndex="0" SelectionChanged="Font_Changed" Margin="0,0,6,6" ToolTip="Font"><ComboBoxItem Content="Arial"/><ComboBoxItem Content="Calibri"/><ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Georgia"/><ComboBoxItem Content="Verdana"/></ComboBox><ComboBox x:Name="FontSizeCombo" Width="65" SelectedIndex="2" SelectionChanged="Size_Changed" Margin="0,0,6,6" ToolTip="Font size in points"><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/><ComboBoxItem Content="12"/><ComboBoxItem Content="14"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/></ComboBox><Button Content="B" FontWeight="Bold" Click="Bold_Click" Focusable="False" Padding="10,5" Margin="0,0,5,6" ToolTip="Bold"/><Button Content="I" FontStyle="Italic" Click="Italic_Click" Focusable="False" Padding="10,5" Margin="0,0,5,6" ToolTip="Italic"/><Button Content="U" Click="Underline_Click" Focusable="False" Padding="10,5" Margin="0,0,5,6" ToolTip="Underline"/><Button Content="Text colour" Click="Colour_Click" Focusable="False" Padding="10,5" Margin="0,0,0,6"/></WrapPanel>
     <WrapPanel Margin="0,0,0,8"><Button Content="Left" Click="Left_Click" Focusable="False" Padding="10,5" Margin="0,0,5,6"/><Button Content="Centre" Click="Centre_Click" Focusable="False" Padding="10,5" Margin="0,0,5,6"/><Button Content="Right" Click="Right_Click" Focusable="False" Padding="10,5" Margin="0,0,5,6"/><Button Content="Add link" Click="Link_Click" Focusable="False" Padding="10,5" Margin="0,0,5,6"/><Button Content="Add picture" Click="Picture_Click" Focusable="False" Padding="10,5" Margin="0,0,0,6"/></WrapPanel>
     <WrapPanel Margin="0,0,0,8"><TextBlock Text="Picture width (px)" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="PictureWidth" Text="160" Width="55" Padding="6"/><Button Content="Resize selected picture" Click="Resize_Click" Padding="10,5" Margin="8,0,0,0"/></WrapPanel>
    </StackPanel>
    <RichTextBox x:Name="Editor" Grid.Row="2" TextChanged="Editor_Changed" VerticalScrollBarVisibility="Auto" AcceptsTab="True" BorderBrush="#DCE4E8" Background="White" Foreground="#172B3A"/>
    <TextBlock x:Name="EditorHint" Grid.Row="3" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
   </Grid></Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock x:Name="Status" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="590"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/><Button Content="Save &amp; use selected" Click="Save_Click" Background="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentForeground}"/></StackPanel></DockPanel>
 </Grid>
</Window>
